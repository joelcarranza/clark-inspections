<?xml version="1.0"?>
<project>
	<bean class="gks.clark.inspections.model.Program">
		<extend>gks.util.SimpleCode</extend>
	</bean>
	
	<bean class="gks.clark.inspections.model.Crew">
		<extend>gks.util.SimpleCode</extend>
	</bean>
	
	
	
	<bean class="gks.clark.inspections.model.SiteFilter">
		<implement>gks.util.dto.DataTransferObject</implement>
		<property name="circuit" />
	</bean>
	
	
	<bean class="gks.clark.inspections.model.SiteList">
		<implement>gks.util.dto.ServerTransferObject</implement>
		<!--
		<implement>gks.util.dto.DataTransferObject</implement>
		-->
		<property name="program" class="gks.clark.inspections.model.Program" />
		<property name="workOrder" class="String" />
		<property name="crew" class="gks.clark.inspections.model.Crew" />
		<property name="sites" class="gks.clark.inspections.model.Site[]" />
		
		<derivedProperty name="key">
			<getter>
				return "";
			</getter>
		</derivedProperty>
	</bean>
	
	<bean class="gks.clark.inspections.model.Site">
		<implement>gks.util.dto.ServerTransferObject</implement>
		<implement>gks.util.Mappable</implement>
		
		<generateTableModel class="gks.clark.inspections.model.SiteTableModel" />
		<property name="key" set="false" key="true"/>
		<property name="x" class="Double" set="false"/>
		<property name="y" class="Double" set="false"/>
		<property name="type" set="false"/>
		<property name="equipmentIdentifier" set="false"/>
		<property name="location" set="false"/>

		<derivedProperty name="mapKey">
			<getter>
				return key;
			</getter>
		</derivedProperty>
		<include>
		public gks.util.BoundingBox getExtent(gks.util.BoundingBox scratchBox) {
			return gks.map.MapControl.getExtent(x,y, scratchBox);
		}
	
		public boolean isMappable() {
			return gks.map.MapControl.isMappable(x,y, getMapKey());
		}
		</include>
	</bean>
	
	
	<bean class="gks.clark.inspections.model.CompletionStatus">
		<extend>gks.util.OrderedCode</extend>
	</bean>
	
	
	<bean class="gks.clark.inspections.model.Inspection">
		<implement>gks.util.dto.ServerTransferObject</implement>
		<implement>gks.util.Mappable</implement>
		
		<generateTableModel class="gks.clark.inspections.model.InspectionTableModel" />
		<property name="key" set="false" key="true"/>
		<property name="x" class="Double" set="false"/>
		<property name="y" class="Double" set="false"/>
		<property name="program" class="gks.clark.inspections.model.Program" set="false"/>
		<property name="type" set="false"/>
		<property name="equipmentIdentifier" set="false"/>
		<property name="location" set="false"/>

		<property name="completionStatus" class="gks.clark.inspections.model.CompletionStatus" />
		<property name="comment" />
		<derivedProperty name="complete" class="boolean">
			<getter>
				return completionStatus != null;
			</getter>
		</derivedProperty>

		<derivedProperty name="mapKey">
			<getter>
				return key;
			</getter>
		</derivedProperty>
		<include>
		public gks.util.BoundingBox getExtent(gks.util.BoundingBox scratchBox) {
			return gks.map.MapControl.getExtent(x,y, scratchBox);
		}
	
		public boolean isMappable() {
			return gks.map.MapControl.isMappable(x,y, getMapKey());
		}
		</include>
	</bean>
	

</project>