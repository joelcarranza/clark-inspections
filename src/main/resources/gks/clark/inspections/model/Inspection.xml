<form>
<import class="gks.clark.mwm.ui.jgoodies.JGoodiesForm" name="jgform" />
<import class="gks.clark.mwm.ui.jgoodies.JGoodiesPanel" name="jgpanel" />
<script><![CDATA[
var gks = Packages.gks;

function onUpdate(m) {
}	


function dateFormat(date)
{
	if(date) {
		var df = java.text.DateFormat.getDateTimeInstance();
		return df.format(date);
	}
	else {
		return '';
	}
	
}


  function validate(results) {
    // comments are optional 
    // cpu thinks users will potentially just do a sketch
    // require either a comment OR an attachment

    var resolutionStatus = form.model.getValue('resolutionStatus');
    var resolutionComment = form.model.getValue('resolutionComment');
	if(resolutionStatus && !resolutionComment) {
	    results.error("A resolution comment must be included");
	  }
  }

]]></script>
<var id="callFirst" type="Boolean" />	
<var id="completionDate" type="Date" />	
<var id="allCrews" type="gks.dispatch.Crew[]" />	
<var id="lifeSupport" type="Boolean" />
<var id="hazard" type="gks.clark.mwm.code.HazardCode" />
<var id="type" />

<var id="hazardText" />
<var id="category" class="String" />

<prototype id="date" format="date:MM/dd/yy H:mm" />
<body beforeUpdate="onUpdate" onValidate="validate">
<border>
		<south>
			<left border="5 | color(#BFBFBF,1,0,0,0)" background="#FFFFFF" visible="$:$completionDate">
				<l fontSize="150%" text="$:'Completed on '+dateFormat($completionDate)" color="#000000"/>
			</left>
		</south>
		<center>
		<border border="10px" vgap="10px">
		<north>
			<table cols="p f " hgap="3"  vgap="3" border="10px">
		<tr>
			<td>Order #</td>
			<td><readOnly id="orderNumber" /></td>
		</tr>
		<tr>
			<td>Customer</td>
			<td><readOnly id="customerName" /></td>
		</tr>
		<tr>
			<td>Address</td>
			<td><readOnlyArea rows="4" id="serviceAddressComplete" /></td>
		</tr>
		<tr>
			<td>Request</td>
			<td><readOnlyArea rows="3" id="request" /></td>
		</tr>
	 </table>
		</north>
			<center>
        <tabs>
          <tab name="Completion">
	           <table cols="p f p" hgap="3"  vgap="3" border="10px">
				<tr>
					<td>ID</td><td columns="2"><readOnly id="key"/></td>
				</tr>
				<tr>
					<td>Program</td><td columns="2"><readOnly id="program"/></td>
				</tr>
				<tr>
					<td>Completion</td><td columns="2"><combo id="completionStatus" dataClass="gks.clark.inspections.model.CompletionStatus" /></td>
				</tr>
				<tr>
					<td>Priority</td><td columns="2"><combo id="issuePriority" dataClass="gks.clark.inspections.model.IssuePriority"  enabled="$:dot($completionStatus,'code')=='X'" /></td>
				</tr>
				<tr>
					<td>Comment</td><td columns="2"><textArea id="comment" length="200"/></td>
				</tr>
				<tr>
					<td>Resolution</td><td columns="2"><combo id="resolutionStatus" dataClass="gks.clark.inspections.model.ResolutionStatus" enabled="$:dot($completionStatus,'code')=='X'" includeNull="true" nullLabel="None" /></td>
				</tr>
				<tr>
					<td>Work Order #</td><td><text id="resolutionWorkOrder" enabled="$:dot($resolutionStatus,'code')=='R'" length="10"/></td>
					<td><button text="Create..." enabled="false" /></td>
				</tr>
				<tr>
					<td>Comment</td><td columns="2"><textArea id="resolutionComment" enabled="$:dot($resolutionStatus,'code')=='R'" length="200"/></td>
				</tr>
				
			 </table>
          </tab>
          <tab name="Attachments">
			<gks.clark.inspections.FileAttachmentView id="attachedFiles" border="10px"  />			
		  </tab>
        </tabs>
			</center>
		</border>
		</center>
		</border>
</body>
</form>
