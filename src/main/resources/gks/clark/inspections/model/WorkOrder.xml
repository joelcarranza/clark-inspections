<form>
<import class="gks.clark.mwm.ui.jgoodies.JGoodiesForm" name="jgform" />
<import class="gks.clark.mwm.ui.jgoodies.JGoodiesPanel" name="jgpanel" />
<script>
var gks = Packages.gks;

function onUpdate(m) {
}	


function dateFormat(date)
{
	if(date) {
		var df = java.text.DateFormat.getDateTimeInstance();
		return df.format(date);
	}
	else {
		return '';
	}
	
}


</script>
<var id="callFirst" type="Boolean" />	
<var id="completionDate" type="Date" />	
<var id="allCrews" type="gks.dispatch.Crew[]" />	
<var id="lifeSupport" type="Boolean" />
<var id="hazard" type="gks.clark.mwm.code.HazardCode" />
<var id="type" />
<var id="listId" class="String" />
<var id="hazardText" />
<var id="category" class="String" />

<prototype id="date" format="date:MM/dd/yy H:mm" />
<body beforeUpdate="onUpdate">	
	<border vgap="10">
		<north>
			<table cols="p f " hgap="3"  vgap="3" border="10px">
				<tr>
					<td>Order #</td>
					<td><readOnly id="orderNumber" /></td>
				</tr>
				<tr>
					<td>Program</td>
					<td><readOnly id="program" /></td>
				</tr>
				<tr>
					<td>Customer</td>
					<td><readOnly id="customerName" /></td>
				</tr>
				<tr>
					<td>Address</td>
					<td><readOnlyArea rows="4" id="serviceAddressComplete" /></td>
				</tr>
				<tr>
					<td>Request</td>
					<td><readOnlyArea rows="3" id="request" /></td>
				</tr>
			 </table>
		</north>
		<center>
			<gks.clark.inspections.InspectionsView id="inspectionsView" listId="$:$listId" visible="$:!!$listId" />
		</center>
	</border>
</body>
</form>
