<form>
<import class="gks.clark.mwm.ui.jgoodies.JGoodiesForm" name="jgform" />
<import class="gks.clark.mwm.ui.jgoodies.JGoodiesPanel" name="jgpanel" />
<script>
var gks = Packages.gks;

function onUpdate(m) {
}	


function dateFormat(date)
{
	if(date) {
		var df = java.text.DateFormat.getDateTimeInstance();
		return df.format(date);
	}
	else {
		return '';
	}
	
}


</script>
<var id="callFirst" type="Boolean" />	
<var id="completionDate" type="Date" />	
<var id="allCrews" type="gks.dispatch.Crew[]" />	
<var id="lifeSupport" type="Boolean" />
<var id="hazard" type="gks.clark.mwm.code.HazardCode" />
<var id="type" />

<var id="hazardText" />
<var id="category" class="String" />

<prototype id="date" format="date:MM/dd/yy H:mm" />
<body beforeUpdate="onUpdate">
<border>
		<south>
			<left border="5 | color(#BFBFBF,1,0,0,0)" background="#FFFFFF" visible="$:$completionDate">
				<l fontSize="150%" text="$:'Completed on '+dateFormat($completionDate)" color="#000000"/>
			</left>
		</south>
		<center>
		<border border="10px" vgap="10px">
		<north>
			<jgpanel columns="645" rows="d,d,d,d,d">
				<cell cc="1,1">
					<jgform columns="56dlu,5dlu,125dlu,15dlu,d,5dlu,56dlu,15dlu,d,5dlu,56dlu">
					<f label="Order #">
						<jgform columns="pref:grow,10px,p,5dlu,50px">
							<readOnly id="orderNumber" />
							<f label="Priority">
								<readOnly id="priority"/>
							</f>
						</jgform>
					</f>
					<f label="Entered"><readOnly id="entryDate" prototype="date"/></f>
					
					<f label="Appointment"><readOnly id="appointmentDate" prototype="date"/></f>
					<eol />

					<!--  row 2 -->
					<f label="Customer"><readOnly id="customerName" /></f>
					<f label="Creator"><readOnly id="creationUser" /></f>
					<f columns="3">
						<left visible="$:$callFirst" background="$:$callFirst? java.awt.Color.YELLOW : null">
							<l><![CDATA[<html><b>Call First</b></html>]]></l>
						</left>
					</f>
					
					<!--  row 3 -->
					
					<row offset="4" />
					<f label="Res Phone"><readOnly id="resPhone" /></f>
				
					<f label="Bus Phone"><readOnly id="busPhone"/></f>
						
					<!--  row 4 -->	
					<row offset="4" />
					<f label="Circ">
						<readOnly id="subFeeder" /></f>
				
					<f label="Cycle / Route">
						<readOnly id="cycleRouteLabel" />	</f>
						
					<!--  row 5 -->
					
					<f label="Special Needs">
						<readOnly id="specialNeeds" /></f>
				
					<f label="Geocode">
						<readOnly id="geocode" /></f>
					
					
					<f label="Action Number">
						<readOnly id="actionNumber"/>
					</f>
					
					<eol/>
					
					<cell cc="1,7">
						Address
					</cell>
					
					<cell cc="3,7,1,3">
						<readOnlyArea id="serviceAddressComplete" rows="3" />
					</cell>
				</jgform>
				</cell>
				<cell cc="1,2">
				<jgform columns="56dlu,5dlu,125dlu,15dlu,d:grow" border="5 0 0 0" visible="$:$category=='F'">
				<!--  row 6 -->
					<!-- TODO: this has been reduced from 4 reasons to 1 so probably can be laid out differently -->
					<f label="Reason" columns="3">
						<hgrid hgap="5px">
							<readOnly id="reason" />
						</hgrid>
					</f>
				</jgform>
				</cell>
				<cell cc="1,3">
				<!--  work location shown for Rio Orders only -->
				<jgform columns="56dlu,5dlu,240dlu,15dlu,d:grow,5dlu,p" border="5 0 0 0" visible="$:$category=='R'" >
					<f label="Work Desc" columns="1">
						<readOnly id="workDescription" />
					</f>
					<f columns="3">
						<check id="inCity" editable="false">In-City</check>
					</f>
					<f label="Light Type" columns="1">
						<readOnly id="lightTypeDesc" />
					</f>
				</jgform>
				</cell>
				<cell cc="1,4">
					<jgform columns="56dlu,5dlu,125dlu,15dlu,d:grow" border="5 0 0 0">
						<f columns="3" label="Request">
							<readOnlyArea rows="3" id="request" />
						</f>
						<eol/>
					</jgform>
				</cell>
				<cell cc="1,5">
					<!--  work location shown for FDSP only -->
					<jgform columns="56dlu,5dlu,125dlu,15dlu,d:grow" border="5 0 0 0" visible="$:$category=='F' &amp;&amp; $type &amp;&amp; $type.code=='FDSP'">
						<f label="Work Location">
							<readOnly id="workLocationLabel" />
						</f>
					</jgform>
				</cell>
			</jgpanel>
		</north>
		</border>
		</center>
		</border>
</body>
</form>
