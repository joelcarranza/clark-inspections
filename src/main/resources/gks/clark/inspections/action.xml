<?xml version='1.0' encoding='utf-8'?>
<config>
  <manager configVersion="3">
    <iconPath>gks/clark/inspections/images</iconPath>
    <iconExt>png</iconExt>
  </manager>
  <condition>
	<site>false</site>
    <inspection>false</inspection>
    <list>false</list>
  </condition>
  <action key="newList">
    <tooltip>Create new assignment list</tooltip>
    <method>actionNewList</method>
    <icon>(none)</icon>
    <enabled>site</enabled>
  </action>
  <action key="openList">
    <method>actionOpenList</method>
    <icon>(none)</icon>
  </action>
  <action key="filter">
    <name>Edit filter...</name>
    <tooltip>Modify the assignment list filter</tooltip>
    <method>actionShowFilter</method>
  </action>
  <action key="open">
    <name>Open....</name>
    <method>actionOpen</method>
    <icon>reports</icon>
  </action>
  <action key="zoom">
    <name>Go to assessment</name>
    <tooltip>Go to the assessment area on the map</tooltip>
    <method>actionZoomSelection</method>
  </action>
    <action key="zoomAll">
    <name>Go to all assessments</name>
    <tooltip>Go to all assessments on the map</tooltip>
    <method>actionZoomAll</method>
  </action>
  <toolbar>
    <main>filter</main>
  </toolbar>
  <menubar>
    <Tools>filter newList openList</Tools>
    <Map>zoom zoomAll</Map>
  </menubar>
</config>