<?xml version='1.0' encoding='utf-8'?>
<config>
  <manager configVersion="3">
    <iconPath>gks/clark/inspections/images</iconPath>
    <iconExt>png</iconExt>
  </manager>
  <condition>
	<sitesVisible>false</sitesVisible>
    <inspectionsVisible>false</inspectionsVisible>
    <list>false</list>
    <workOrdersVisible>false</workOrdersVisible>
    <singleItemSelected>false</singleItemSelected>
    <itemsSelected>false</itemsSelected>
    <selectedItemsMappable>false</selectedItemsMappable>
    <itemsMappable>false</itemsMappable>
  </condition>
  
  <action key="refresh">
	<name>Refresh</name>
	<method>actionRefresh</method>
  </action>

  <action key="filter">
    <name>Choose Sites...</name>
    <method>actionShowSiteFilter</method>
    <enabled>workOrdersVisible AND singleItemSelected</enabled>
  </action>
  <action key="newList">
	<name>Assign List...</name>
    <method>actionNewList</method>
    <enabled>sitesVisible</enabled>
  </action>
  
  <action key="displaySettings">
	<name>Display Settings</name>
    <method>actionDisplaySettings</method>
    <icon>filter</icon>
  </action>
  <action key="openList">
	<name>Open List...</name>
    <method>actionOpenList</method>
    <enabled>workOrdersVisible AND singleItemSelected </enabled>
  </action>
  <action key="addSites">
	<name>Add Sites to List...</name>
    <method>actionAddSites</method>
    <enabled>sitesVisible</enabled>
    <icon>plus</icon>
  </action>
  <action key="removeSites">
	<name>Remove Sites from List...</name>
    <method>actionRemoveSites</method>
    <enabled>sitesVisible AND itemsSelected</enabled>
    <icon>minus</icon>
  </action>

  <action key="viewWorkOrders">
	<name>View Work Orders</name>
    <method>actionViewWorkOrders</method>
  </action>

  <action key="viewExceptions">
    <name>View Exceptions</name>
    <method>actionViewExceptions</method>
  </action>

  <action key="open">
    <name>Open....</name>
    <method>actionOpen</method>
    <enabled>itemsSelected</enabled>
  </action>
  <action key="zoom">
    <name>View all on map</name>
    <method>actionZoomSelection</method>
    <enabled>selectedItemsMappable</enabled>
  </action>
    <action key="zoomAll">
    <name>View selected on map</name>
    <method>actionZoomAll</method>
    <enabled>itemsMappable</enabled>
  </action>
  <toolbar>
    <main>open | zoom zoomAll addSites removeSites | displaySettings | refresh</main>
  </toolbar>
  <menubar>
    <Tools>viewWorkOrders viewExceptions | filter newList openList addSites removeSites | displaySettings refresh</Tools>
    <Map>zoom zoomAll</Map>
  </menubar>
</config>