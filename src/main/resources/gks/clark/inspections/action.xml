<?xml version='1.0' encoding='utf-8'?>
<config>
  <manager configVersion="3">
    <iconPath>gks/clark/inspections/images</iconPath>
    <iconExt>png</iconExt>
  </manager>
  <condition>
	<site>false</site>
    <inspection>false</inspection>
    <list>false</list>
    <workOrder>false</workOrder>
    <singleItemSelected>false</singleItemSelected>
  </condition>

  <action key="filter">
    <name>Choose Sites...</name>
    <method>actionShowSiteFilter</method>
    <enabled>workOrder AND singleItemSelected</enabled>
  </action>
  <action key="newList">
	<name>New List...</name>
    <method>actionNewList</method>
    <enabled>site</enabled>
  </action>
  <action key="openList">
	<name>Open List...</name>
    <method>actionOpenList</method>
  </action>

  <action key="viewWorkOrders">
	<name>View Work Orders</name>
    <method>actionViewWorkOrders</method>
  </action>

  <action key="viewExceptions">
    <name>View Exceptions</name>
    <method>actionViewExceptions</method>
  </action>

  <action key="open">
    <name>Open....</name>
    <method>actionOpen</method>
  </action>
  <action key="zoom">
    <name>Go to assessment</name>
    <tooltip>Go to the assessment area on the map</tooltip>
    <method>actionZoomSelection</method>
  </action>
    <action key="zoomAll">
    <name>Go to all assessments</name>
    <tooltip>Go to all assessments on the map</tooltip>
    <method>actionZoomAll</method>
  </action>
  <toolbar>
    <main>open | zoom zoomAll</main>
  </toolbar>
  <menubar>
    <Tools>viewWorkOrders viewExceptions | filter newList openList</Tools>
    <Map>zoom zoomAll</Map>
  </menubar>
</config>