<?xml version='1.0' encoding='utf-8'?>
<config>
  <manager configVersion="3">
    <iconPath>gks/clark/inspections/images</iconPath>
    <iconExt>png</iconExt>
    <iconSize>32</iconSize>
  </manager>
<condition>
    <canBack>false</canBack>
    <canNext>false</canNext>
    <itemMappable>false</itemMappable>
    <list>false</list>
  </condition>
  <action key="first">
    <method>actionFirst</method>
    <enabled>canBack</enabled>
  </action>
  <action key="last">
    <method>actionLast</method>
    <enabled>canNext</enabled>
  </action>
  <action key="prev">
    <method>actionBack</method>
    <enabled>canBack</enabled>
  </action>
  <action key="next">
    <method>actionNext</method>
    <enabled>canNext</enabled>
  </action> 
  <action key="zoom">
    <method>actionZoom</method>
    <enabled>itemMappable</enabled>
    <icon>map</icon>
  </action>
  
  <action key="openAllInspections">
	<method>actionOpenAllInspections</method>
	<icon>folder-open</icon>
	<enabled>list</enabled>
  </action>
    <toolbar>
    <main>first prev next last | openAllInspections zoom</main>
  </toolbar>
</config>