<?xml version='1.0' encoding='utf-8'?>
<config>
  <manager configVersion="3">
    <iconPath>gks/clark/inspections/images</iconPath>
    <iconExt>png</iconExt>
    <iconSize>32</iconSize>
  </manager>
<condition>
    <canBack>false</canBack>
    <canNext>false</canNext>
    <itemMappable>false</itemMappable>
  </condition>
  <action key="first">
    <method>actionFirst</method>
    <enabled>canBack</enabled>
  </action>
  <action key="last">
    <method>actionLast</method>
    <enabled>canNext</enabled>
  </action>
  <action key="prev">
    <method>actionBack</method>
    <enabled>canBack</enabled>
  </action>
  <action key="next">
    <method>actionNext</method>
    <enabled>canNext</enabled>
  </action>
  <action key="save">
    <method>actionSave</method>
    <tooltip>Save this assessment</tooltip>
  </action>
    <action key="zoom">
    <method>actionZoom</method>
    <enabled>itemMappable</enabled>
    <icon>map</icon>
  </action>
    <toolbar>
    <main>first prev next last | save | zoom </main>
  </toolbar>
</config>